{
  "manifestVersion": 1,
  "id": "biaoqingbao",
  "name": "表情包",
  "version": "0.33.101",
  "description": "让助手在回复中根据语境自然使用表情包。支持批量图片与 ZIP 导入/导出迁移、AI 识图自动打标签、语义向量检索、聊天式标签调整、助手配图频率控制、偏好记忆和桌面纸飞机悬浮球，带气体尾流与流星特效。方言口音：可给不同助手配不同方言（含「学我说话」：总结你自己的说话习惯，让助手模仿你），开启后写入助手人格文件；加强版开关常驻，开启后每轮对话有方言回响（正事场合自动让路）。学我说话 v2 用分通道流水线精细提炼，带数据画像展示与修正回流。首次安装为空图库。",
  "trust": "full-access",
  "install": {
    "defaultEnabled": true
  },
  "activationEvents": [
    "onStartup"
  ],
  "capabilities": [
    "model",
    "session",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "*",
      "127.0.0.1",
      "localhost"
    ],
    "allowLocalhost": true,
    "methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "HEAD",
      "PATCH"
    ],
    "defaultTimeoutMs": 30000
  },
  "main": "index.js",
  "contributes": {
    "page": {
      "title": "表情包",
      "route": "/page"
    },
    "routes": [
      "./routes/ui.js",
      "./routes/api.js"
    ],
    "extensions": [
      "./extensions/observer.js",
      "./extensions/dialect-boost.js"
    ],
    "tools": [
      "./tools/express.js",
      "./tools/search-stickers.js",
      "./tools/pick-sticker.js",
      "./tools/add-sticker.js",
      "./tools/update-sticker-tags.js",
      "./tools/list-stickers.js",
      "./tools/report-bad-match.js"
    ]
  }
}
