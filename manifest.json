{
  "manifestVersion": 1,
  "id": "biaoqingbao",
  "name": "表情包",
  "version": "0.19.6",
  "description": "让助手在回复中根据语境自然使用表情包。支持批量图片与 ZIP 导入、AI 识图自动打标签、语义向量检索、聊天式标签调整、助手配图频率控制和偏好记忆。首次安装为空图库。",
  "trust": "full-access",
  "install": {
    "defaultEnabled": true
  },
  "activationEvents": [
    "onStartup"
  ],
  "capabilities": [
    "model",
    "session",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "*"
    ],
    "defaultTimeoutMs": 30000
  },
  "main": "index.js",
  "contributes": {
    "page": {
      "title": "表情包",
      "route": "/page"
    },
    "routes": [
      "./routes/ui.js",
      "./routes/api.js"
    ],
    "extensions": [
      "./extensions/observer.js"
    ],
    "tools": [
      "./tools/express.js",
      "./tools/search-stickers.js",
      "./tools/pick-sticker.js",
      "./tools/add-sticker.js",
      "./tools/update-sticker-tags.js",
      "./tools/list-stickers.js",
      "./tools/report-bad-match.js"
    ]
  }
}
